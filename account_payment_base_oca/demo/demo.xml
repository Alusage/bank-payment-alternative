<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Odoo 20 dropped the res.bank model: a bank is no longer a record of its own,
  res.partner.bank carries its name and BIC as plain char fields. The four
  standalone bank records this file used to create have no equivalent, so their
  data is inlined on the accounts that referenced them.
-->
<odoo noupdate="1">
    <record id="main_company_iban" model="res.partner.bank">
        <field name="account_number">FR76 4242 4242 4242 4242 4242 424</field>
        <field name="bank_name">La Banque Postale</field>
        <field name="bank_bic">PSSTFRPPXXX</field>
        <field name="partner_id" ref="base.main_partner" />
    </record>
    <record id="main_company_iban2" model="res.partner.bank">
        <field name="account_number">FR20 1242 1242 1242 1242 1242 124</field>
        <field name="bank_name">Société Générale</field>
        <field name="bank_bic">SOGEFRPPXXX</field>
        <field name="partner_id" ref="base.main_partner" />
    </record>
    <record id="res_partner_12_iban" model="res.partner.bank">
        <field name="account_number">FR66 1212 1212 1212 1212 1212 121</field>
        <field name="bank_name">Qonto</field>
        <field name="bank_bic">QNTOFRP1XXX</field>
        <field name="partner_id" ref="base.res_partner_12" />
    </record>
    <record id="res_partner_2_iban" model="res.partner.bank">
        <field name="account_number">BE96 9988 7766 5544</field>
        <field name="bank_name">BNP Paribas Fortis Charleroi</field>
        <field name="bank_bic">GEBABEBB03A</field>
        <field name="partner_id" ref="base.res_partner_2" />
    </record>
</odoo>
